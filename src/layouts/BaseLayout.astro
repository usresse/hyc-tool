---
import '../styles/global.css';
import ThemePanel from '../components/ThemePanel.astro';
import { NAV, SITE, withBase } from '../consts';

interface Props {
  title: string;
  description?: string;
  /** false 时不渲染站点头部/页脚（用于全屏包装页） */
  chrome?: boolean;
}

const { title, description = SITE.description, chrome = true } = Astro.props;

const nav = NAV.map((item) => ({ ...item, href: withBase(item.href) }));
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
  const normalized = href.replace(/\/+$/, '') || '/';
  if (normalized === '/') return currentPath === '/';
  return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
};

const year = new Date().getFullYear();
const fullTitle =
  title === SITE.name ? `${SITE.name} · ${SITE.tagline}` : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3efe4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15130e" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{fullTitle}</title>
    <!-- 首屏预热：从本地缓存直接恢复主题，避免闪烁（正式逻辑见页面底部 theme.js） -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var t = null;
        try { t = JSON.parse(localStorage.getItem('site:theme:resolved') || 'null'); } catch (e) {}
        try {
          if (!t) {
            var s = JSON.parse(localStorage.getItem('site:theme:v1') || '{}');
            var m = s.mode || 'auto';
            var dark = m === 'dark' || (m === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            d.setAttribute('data-theme', dark ? 'dark' : 'light');
          }
        } catch (e) {}
        if (t) {
          d.setAttribute('data-theme', t.theme || 'light');
          if (t.accent) d.style.setProperty('--accent', t.accent);
          if (t.ink) d.style.setProperty('--accent-ink', t.ink);
          if (t.soft) d.style.setProperty('--accent-soft', t.soft);
          if (t.bg) {
            d.style.setProperty('--page-bg', t.bg);
            d.style.setProperty('--page-bg-size', t.bgSize || 'auto');
            d.style.setProperty('--page-scrim', t.scrim || 'none');
          }
        }
        d.style.colorScheme = (d.getAttribute('data-theme') === 'dark') ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>

    {
      chrome && (
        <header class="site-header">
          <div class="container site-header__inner">
            <a class="brand" href={withBase('/')} aria-label={`${SITE.name} 首页`}>
              <span class="brand__stamp" aria-hidden="true">自</span>
              <span class="brand__text">
                <span class="brand__name">{SITE.name}</span>
                <span class="brand__latin">{SITE.latin}</span>
              </span>
            </a>

            <div class="site-header__end">
              <nav class="site-nav" aria-label="主导航">
                {nav.map((item) => (
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))}
              </nav>
              <button
                type="button"
                class="theme-trigger"
                data-theme-open
                aria-label="外观设置"
                title="外观设置"
              >
                🎨
              </button>
            </div>
          </div>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      chrome && (
        <footer class="site-footer">
          <div class="container site-footer__inner">
            <span>© {year} {SITE.name} · 数据只留在你的浏览器里</span>
            <span>ASTRO + PREACT · 静态部署</span>
          </div>
        </footer>
      )
    }

    <ThemePanel />

    <script>
      import '../assets/theme.js';
    </script>
  </body>
</html>
