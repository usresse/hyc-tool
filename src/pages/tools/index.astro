---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { TOOLS, withBase } from '../../consts';

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="工具箱" description="一组在线小工具：JSON、时间戳、编码、正则、UUID、Cron、Hash、文本对比、配置转换、密码、二维码。输入不保存，刷新即重置。">
  <div class="container">
    <header class="page-head">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href={withBase('/')}>首页</a>
        <span class="sep" aria-hidden="true">/</span>
        <span>工具箱</span>
      </nav>
      <h1>工具箱</h1>
      <p class="page-head__desc">
        一组纯前端的小工具。所有处理都在浏览器里完成，输入不进 localStorage，也不发往任何服务器。
      </p>
      <p class="page-head__note">
        <span>{TOOLS.length} 个工具</span>
        <span>刷新即重置</span>
      </p>
    </header>

    <div class="section" style="padding-top: 32px;">
      <div class="grid">
        {
          TOOLS.map((tool, i) => (
            <ToolCard
              href={withBase(`/tools/${tool.slug}`)}
              title={tool.title}
              desc={tool.desc}
              emoji={tool.emoji}
              num={pad(i + 1)}
              meta="Tool"
            />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
