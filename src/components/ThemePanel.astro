---
// 全站外观设置面板：内容由 /assets/theme.js 动态渲染
---

<div class="theme-overlay" id="themeOverlay" role="dialog" aria-modal="true" aria-label="外观设置">
  <div class="theme-panel">
    <div class="theme-panel__head">
      <h2>🎨 外观设置</h2>
      <button type="button" class="theme-close" data-theme-close aria-label="关闭">✕</button>
    </div>
    <div class="theme-panel__body" id="themePanelBody"></div>
    <p class="theme-panel__foot">设置保存在本地浏览器，对所有页面生效。</p>
  </div>
</div>
